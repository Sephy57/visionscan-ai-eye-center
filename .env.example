# ---------------------------------------------------------------------------
# AI EYE ANALYSIS PLATFORM - environment configuration (EXAMPLE)
# Copy to .env and adjust. Never commit the real .env file.
# All paths below point to drive D: as required by project policy.
# ---------------------------------------------------------------------------

# Canonical project / data roots (Windows paths; spaces are fine in .env)
PROJECT_ROOT=D:\AI EYE ANALYSIS PLATFORM
DATA_ROOT=D:\AI EYE ANALYSIS PLATFORM\data

# Storage locations
UPLOAD_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\uploads
DOCUMENTS_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\documents
PROCESSED_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\processed
REPORT_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\reports
DATABASE_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\database
MODEL_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\models
LOG_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\logs
TMP_ROOT=D:\AI EYE ANALYSIS PLATFORM\data\tmp

# SQLite database file (if/when SQLite is enabled; JSON store is the default)
DATABASE_FILE=D:\AI EYE ANALYSIS PLATFORM\data\database\eye-ai.db

# Server
PORT=3000
NODE_ENV=development

# Max upload size (bytes) - 25 MB
MAX_UPLOAD_BYTES=26214400

# Document (PDF) ingestion limits (S1)
MAX_DOCUMENT_BYTES=26214400
MAX_DOCUMENT_PAGES=100
# Defined in S1, enforced from S2 (page rasterization for OCR):
MAX_DOCUMENT_RENDER_DIMENSION_PX=4000
MAX_DOCUMENT_EMBEDDED_RESOURCE_BYTES=26214400

# Document text/OCR extraction limits (S2)
MAX_EXTRACTION_CHARS_PER_DOC=500000
MAX_EXTRACTION_CHARS_PER_PAGE=50000
MAX_EXTRACTION_TIME_MS=240000
MAX_OCR_TIME_MS=90000
MIN_TEXT_LAYER_CHARS=32
# Tesseract.js language-data cache (defaults to data\ocr\tessdata). Pre-warm
# with `npm run ocr:warmup`; no network needed after that.
# OCR_TESSDATA_PATH=D:\AI EYE ANALYSIS PLATFORM\data\ocr\tessdata

# Analysis behavior
# DEMO_MODE forces the synthetic analysis engine. Synthetic output is always
# labeled "DEMO / SYNTHETIC RESULT - NOT FOR CLINICAL USE".
DEMO_MODE=true

# Validation status banner shown on every result/report
VALIDATION_STATUS=NOT VALIDATED - NOT A MEDICAL DEVICE - NOT FOR CLINICAL USE

# ---------------------------------------------------------------------------
# Secrets: add real values only in .env (never committed).
# ---------------------------------------------------------------------------
# SESSION_SECRET=change-me
# ADMIN_TOKEN=change-me
