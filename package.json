{
  "name": "eye-ai-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI Eye Scan Analysis & Clinical Decision-Support Platform (screening architecture - NOT a medical device; demo/synthetic analysis not for clinical use)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build --webpack",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "validation:cases": "vitest run tests/validation-case-package-and-model-errors.test.ts --pool=forks --maxWorkers=1 --minWorkers=1",
    "smoke": "node scripts/smoke.mjs",
    "visual-qa": "node scripts/visual-qa.mjs",
    "browser:responsive": "node scripts/browser-responsive-qa.mjs",
    "browser:a11y": "node scripts/browser-accessibility-qa.mjs",
    "browser:keyboard": "node scripts/browser-keyboard-qa.mjs",
    "browser:asset-e2e": "node scripts/browser-asset-e2e.mjs",
    "browser:ci": "node scripts/browser-ci.mjs",
    "performance:local": "node scripts/performance-local.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "model:audit": "node scripts/model-manifest-audit.mjs",
    "release:inventory": "node scripts/release-inventory.mjs",
    "setup": "node scripts/setup-dirs.mjs",
    "db:init": "vite-node scripts/init-db.ts",
    "audit:fs": "node scripts/audit-filesystem.mjs",
    "seed:admin": "node scripts/seed-admin.mjs",
    "ocr:warmup": "node scripts/ocr-warmup.mjs",
    "migration:preflight": "node scripts/persistence-migration-preflight.mjs",
    "fk:preflight": "node scripts/fk-preflight.mjs",
    "reconciliation:adjudicate": "vite-node scripts/reconciliation-adjudicate.ts",
    "migrate:data": "node scripts/migrate-data.mjs",
    "backup:data": "node scripts/backup-data.mjs",
    "restore:data": "node scripts/restore-data.mjs",
    "benchmark:persistence": "node scripts/persistence-benchmark.mjs",
    "stress:workspace": "node scripts/stress-workspace.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "better-sqlite3": "^11.10.0",
    "next": "^16.3.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.3.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/parser": "^8.70.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright-core": "^1.62.1",
    "typescript": "5.5.3",
    "vitest": "^3.2.6"
  }
}
