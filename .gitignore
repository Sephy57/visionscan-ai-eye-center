logs/
*.log

# Temp
tmp/
*.tmp

# Caches
.cache/
.eslintcache
**/__pycache__/

# Build output
.next/
out/
dist/
build/

# Dependencies
node_modules/

# S7 - isolated research-only Python environment for candidate model work
# (never global/user site-packages; ~700MB+ of PyTorch binaries - never commit)
.venv-ophthalmic/

# S9 - downloaded research model artifacts and test images live here, never
# in data/models/ and never committed (checkpoints, sample images, .safetensors)
scratch/

